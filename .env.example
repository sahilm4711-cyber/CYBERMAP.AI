# CyberMap AI — environment template.
# Copy to .env and fill in your OWN values. NEVER commit a real .env.
# No secrets are stored in this repository.

# --- Application ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
# Session cookie secret is derived from SECRET_KEY.

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=cybermap
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_DB=cybermap
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://cybermap:change-me-in-.env@localhost:5432/cybermap

# --- Redis (caching + job coordination) ---
REDIS_URL=redis://localhost:6379/0

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- AI providers (Phase 6) ---
# Leave empty for the fully functional non-AI fallback mode.
# When you use a provider, set ONE of these (never commit the key):
#   AI_PROVIDER=openai | groq | google-gemini
#   AI_MODEL=<model name, e.g. gpt-4o-mini>
#   OPENAI_API_KEY=...
#   GROQ_API_KEY=...
#   GOOGLE_API_KEY=...
AI_PROVIDER=
AI_MODEL=

# --- Sessions / auth (Phase 3) ---
# Cookie name, lifetime in days, and whether the cookie requires HTTPS.
# Keep SESSION_COOKIE_SECURE=false for local http:// development;
# set it to true in production.
SESSION_COOKIE_NAME=cybermap_session
SESSION_EXPIRE_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
PASSWORD_MIN_LENGTH=8

# --- Ingestion (Phase 4) ---
# Optional NVD API key (free, raises the rate limit). Without it the
# connector works anonymously at the lower public rate limit.
NVD_API_KEY=
